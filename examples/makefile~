CC=gcc

# RELEASE
CFLAGS=-pedantic -Wall -std=c99 -D_GNU_SOURCE -fPIC -I/opt/homebrew/include 

LDFLAGS=-L/opt/homebrew/lib
LDLIBS=-lm -lcurl

.DEFAULT: basic1

basic1: mk_dir
	@echo ""
	@echo "Compiling problem file ..."
	$(CC) ${CFLAGS} ${LDFLAGS} -o basic_example_1 basic_example_1.c ../src/pull_horizons.c ${LDLIBS}
	@echo ""
	@echo "Problem file compiled successfully."
	./basic_example_1
	@echo ""
	@echo "Problem file executed."

basic2: mk_dir
	@echo ""
	@echo "Compiling problem file ..."
	$(CC) ${CFLAGS} ${LDFLAGS} -o basic_example_2 basic_example_2.c ../src/pull_horizons.c ${LDLIBS}
	@echo ""
	@echo "Problem file compiled successfully."
	./basic_example_2
	@echo ""
	@echo "Problem file executed."

irreg: mk_dir
	@echo ""
	@echo "Compiling problem file ..."
	$(CC) ${CFLAGS} ${LDFLAGS} -o irregular_example irregular_example.c ../src/pull_horizons.c ${LDLIBS}
	@echo ""
	@echo "Problem file compiled successfully."
	./irregular_example
	@echo ""
	@echo "Problem file executed."

mk_dir:
	mkdir -p outputs

clean:
	@echo "Cleaning up local directory ..."
	@-rm -vf basic_example_1
	@-rm -vf basic_example_2
	@-rm -vf irregular_example